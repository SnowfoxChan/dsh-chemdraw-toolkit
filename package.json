{
  "name": "dsh-chemdraw-toolkit",
  "version": "0.2.2",
  "description": "Agent tools that drive a local ChemDraw + Chem3D installation on Windows: draw and beautify structures, predict 1H/13C NMR with ChemNMR, build 3D models with MM2, convert chemical formats and recognise structures from images.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "chemdraw",
    "chem3d",
    "chemistry",
    "chemscript",
    "nmr",
    "3d",
    "conformer",
    "structure",
    "cdx"
  ],
  "type": "module",
  "main": "index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "backend",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "screenshots.json",
    "docs/screenshots",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SnowfoxChan/dsh-chemdraw-toolkit.git"
  },
  "homepage": "https://github.com/SnowfoxChan/dsh-chemdraw-toolkit",
  "bugs": {
    "url": "https://github.com/SnowfoxChan/dsh-chemdraw-toolkit/issues"
  },
  "license": "MIT"
}
